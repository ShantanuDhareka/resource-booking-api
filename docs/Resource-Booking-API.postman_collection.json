{
  "info": {
    "name": "Resource Booking API",
    "description": "JWT-secured resource booking endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as ADMIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login as USER",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"User@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "List resources",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/resources"
          }
        },
        {
          "name": "Create resource (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lab Room\",\n  \"description\": \"Quiet workspace\",\n  \"type\": \"ROOM\",\n  \"location\": \"Floor 3\",\n  \"hourlyRate\": 30.00,\n  \"available\": true\n}"
            },
            "url": "{{baseUrl}}/api/resources"
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create reservation (USER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": 1,\n  \"startTime\": \"2026-10-01T10:00:00Z\",\n  \"endTime\": \"2026-10-01T12:00:00Z\",\n  \"notes\": \"Project kickoff\"\n}"
            },
            "url": "{{baseUrl}}/api/reservations"
          }
        },
        {
          "name": "List reservations with filters",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/reservations?status=PENDING&minPrice=10&maxPrice=500&page=0&size=10&sort=price,desc"
          }
        }
      ]
    }
  ]
}
